{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 380,
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Storage included'])",
      "as": "mb"
    },
    {
      "filter": "isValid(datum.mb) && datum.mb > 0"
    },
    {
      "calculate": "indexof([16,8,32,4,10], datum.mb) >= 0 ? format(datum.mb, 'd') + ' MB' : 'Other sizes'",
      "as": "size"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "models"
        }
      ],
      "groupby": [
        "size"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "models",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.size == 'Other sizes' ? -1 : datum.models",
      "as": "ord"
    },
    {
      "calculate": "round(datum.models / datum.total * 100)",
      "as": "pct"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "pct",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "ord",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.size == 'Other sizes' ? 0 : datum.cum",
      "as": "topcum"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "topcum",
          "as": "top"
        }
      ]
    },
    {
      "calculate": "datum.size == 'Other sizes' ? 100 - datum.top : datum.pct",
      "as": "pct"
    },
    {
      "calculate": "datum.size == 'Other sizes' ? 100 : datum.cum",
      "as": "cum"
    },
    {
      "calculate": "sequence(datum.cum - datum.pct, datum.cum)",
      "as": "k"
    },
    {
      "flatten": [
        "k"
      ]
    },
    {
      "calculate": "datum.k % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.k / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "square",
    "size": 1000,
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "size",
      "type": "nominal",
      "title": "Memory card",
      "sort": {
        "field": "ord",
        "order": "descending"
      },
      "scale": {
        "domain": [
          "16 MB",
          "8 MB",
          "32 MB",
          "4 MB",
          "10 MB",
          "Other sizes"
        ],
        "range": [
          "#2f5d8a",
          "#4e79a7",
          "#7fa6cc",
          "#a9c4de",
          "#cfdcea",
          "#e5e7eb"
        ]
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 11,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {
        "field": "size",
        "type": "nominal",
        "title": "Storage included"
      },
      {
        "field": "models",
        "type": "quantitative",
        "title": "Camera models"
      },
      {
        "field": "pct",
        "type": "quantitative",
        "title": "Squares (1 square = 1% of models)"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans"
  }
}