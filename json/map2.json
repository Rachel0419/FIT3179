{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 440,
  "projection": {
    "type": "mercator",
    "center": [
      139.74,
      35.67
    ],
    "scale": 65000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
        "format": {
          "type": "topojson",
          "feature": "japan"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F7F5F0",
        "stroke": "#CFC9BC",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/tokyo_clean.csv"
      },
      "transform": [
        {
          "calculate": "floor(datum.longitude*100)/100",
          "as": "clon"
        },
        {
          "calculate": "floor(datum.latitude*100)/100",
          "as": "clat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "clon",
            "clat"
          ]
        },
        {
          "filter": "datum.n >= 3"
        },
        {
          "calculate": "datum.clon + 0.01",
          "as": "clon2"
        },
        {
          "calculate": "datum.clat + 0.01",
          "as": "clat2"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.95,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "clon",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "clon2"
        },
        "latitude": {
          "field": "clat",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "clat2"
        },
        "color": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "scheme": {
              "name": "orangered",
              "extent": [
                0.15,
                1
              ]
            }
          },
          "legend": {
            "title": "Photos per 1 km square",
            "orient": "bottom-right",
            "gradientLength": 110,
            "format": "d",
            "values": [
              3,
              50,
              150,
              300
            ]
          }
        },
        "tooltip": [
          {
            "field": "n",
            "type": "quantitative",
            "title": "Photos in this square"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#E6EEF5"
    },
    "font": "Open Sans",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.9)",
      "padding": 6,
      "cornerRadius": 3,
      "strokeColor": "#d8dde5"
    }
  }
}