{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 480,
  "projection": {
    "type": "mercator",
    "center": [
      139.74,
      35.675
    ],
    "scale": 80000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
        "format": {
          "type": "topojson",
          "feature": "japan"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8ECF1",
        "stroke": "#C3CBD6",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/tokyo_clean.csv"
      },
      "transform": [
        {
          "calculate": "floor(datum.longitude * 100) / 100",
          "as": "clon"
        },
        {
          "calculate": "floor(datum.latitude * 100) / 100",
          "as": "clat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "clon",
            "clat"
          ]
        },
        {
          "filter": "datum.n >= 3"
        },
        {
          "calculate": "datum.clon + 0.01",
          "as": "clon2"
        },
        {
          "calculate": "datum.clat + 0.01",
          "as": "clat2"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.92,
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {
          "field": "clon",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "clon2"
        },
        "latitude": {
          "field": "clat",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "clat2"
        },
        "color": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "scheme": {
              "name": "orangered",
              "extent": [
                0.2,
                1
              ]
            }
          },
          "legend": {
            "title": "Photos per square",
            "orient": "bottom-right",
            "gradientLength": 110,
            "format": "d"
          }
        },
        "tooltip": [
          {
            "field": "n",
            "type": "quantitative",
            "title": "Photos in this square"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 139.7421,
            "lat": 35.715,
            "text": "Ueno · 417"
          },
          {
            "lon": 139.8003,
            "lat": 35.675,
            "text": "Ginza · 396"
          },
          {
            "lon": 139.835,
            "lat": 35.715,
            "text": "Asakusa · 309"
          },
          {
            "lon": 139.665,
            "lat": 35.655,
            "text": "Shibuya · 205"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#ffffff",
        "stroke": "#ffffff",
        "strokeWidth": 4,
        "strokeJoin": "round",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 139.7421,
            "lat": 35.715,
            "text": "Ueno · 417"
          },
          {
            "lon": 139.8003,
            "lat": 35.675,
            "text": "Ginza · 396"
          },
          {
            "lon": 139.835,
            "lat": 35.715,
            "text": "Asakusa · 309"
          },
          {
            "lon": 139.665,
            "lat": 35.655,
            "text": "Shibuya · 205"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2430"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.88)",
      "padding": 6,
      "cornerRadius": 3
    }
  }
}