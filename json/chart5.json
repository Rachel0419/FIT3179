{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": {
    "step": 28
  },
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Price)",
      "as": "Price"
    },
    {
      "calculate": "split(datum.Model, ' ')[0]",
      "as": "Brand"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "models"
        },
        {
          "op": "distinct",
          "field": "Price",
          "as": "price_levels"
        }
      ],
      "groupby": [
        "Brand"
      ]
    },
    {
      "filter": "datum.models >= 15 && datum.price_levels >= 5"
    }
  ],
  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "size": 16,
    "color": "#7fa6cc",
    "median": {
      "color": "#1b2430",
      "thickness": 2.5
    },
    "rule": {
      "color": "#7b8794"
    },
    "ticks": {
      "color": "#7b8794",
      "size": 8
    },
    "outliers": {
      "size": 14,
      "color": "#7b8794",
      "opacity": 0.45,
      "filled": true
    }
  },
  "encoding": {
    "y": {
      "field": "Brand",
      "type": "nominal",
      "title": null,
      "sort": [
        "Sony",
        "Olympus",
        "Pentax",
        "Epson",
        "Kyocera",
        "Nikon",
        "Samsung",
        "Canon",
        "Fujifilm",
        "Ricoh",
        "Toshiba"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelColor": "#1b2430",
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "Price",
      "type": "quantitative",
      "title": "Price (US$, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          50,
          10000
        ]
      },
      "axis": {
        "values": [
          100,
          300,
          1000,
          3000,
          10000
        ],
        "format": "$,.0f",
        "grid": true
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1b2430",
      "labelColor": "#5b6776",
      "gridColor": "#edf0f5",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelColor": "#5b6776"
    }
  }
}