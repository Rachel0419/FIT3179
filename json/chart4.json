{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 480,
  "height": 380,
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "mark": {
    "type": "circle",
    "color": "#4e79a7",
    "opacity": 0.45
  },
  "encoding": {
    "x": {
      "field": "Release date",
      "type": "quantitative",
      "title": "Release year",
      "scale": {
        "zero": false,
        "padding": 12
      },
      "axis": {
        "values": [
          1994,
          1996,
          1998,
          2000,
          2002,
          2004,
          2006
        ],
        "format": "d",
        "grid": false
      }
    },
    "y": {
      "field": "Price",
      "type": "quantitative",
      "title": "Price (US$, log scale)",
      "scale": {
        "type": "log"
      },
      "axis": {
        "values": [
          10,
          30,
          100,
          300,
          1000,
          3000,
          10000
        ],
        "format": "$,.0f",
        "grid": true
      }
    },
    "size": {
      "field": "Effective pixels",
      "type": "quantitative",
      "scale": {
        "type": "linear",
        "zero": true,
        "range": [
          10,
          200
        ]
      },
      "legend": {
        "title": "Megapixels",
        "orient": "top-left",
        "values": [
          2,
          5,
          10,
          20
        ],
        "symbolFillColor": "#4e79a7",
        "symbolOpacity": 0.6
      }
    },
    "tooltip": [
      {
        "field": "Model",
        "type": "nominal",
        "title": "Camera"
      },
      {
        "field": "Release date",
        "type": "quantitative",
        "title": "Release year",
        "format": "d"
      },
      {
        "field": "Price",
        "type": "quantitative",
        "title": "Price (US$)",
        "format": ",.0f"
      },
      {
        "field": "Effective pixels",
        "type": "quantitative",
        "title": "Megapixels"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "gridColor": "#e4e9f0",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.88)",
      "padding": 6,
      "cornerRadius": 3
    }
  }
}