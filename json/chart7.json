{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 380,
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "Zoom wide (W)",
      "type": "quantitative",
      "bin": {"maxbins": 15},
      "title": "Zoom Wide (mm)"
    },
    "y": {
      "field": "Max resolution",
      "type": "quantitative",
      "bin": {"maxbins": 15},
      "title": "Max Resolution"
    },
    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Model Count",
      "scale": {"scheme": "greens"}
    },
    "tooltip": [
      {"field": "Zoom wide (W)", "type": "quantitative", "bin": true, "title": "Zoom Range"},
      {"field": "Max resolution", "type": "quantitative", "bin": true, "title": "Resolution Range"},
      {"aggregate": "count", "type": "quantitative", "title": "Number of Models"}
    ]
  }
}