{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 480,
  "height": {
    "step": 22
  },
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "transform": [
    {
      "calculate": "split(datum.Model, ' ')[0]",
      "as": "Brand"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "models"
        },
        {
          "op": "distinct",
          "field": "Price",
          "as": "price_levels"
        }
      ],
      "groupby": [
        "Brand"
      ]
    },
    {
      "filter": "datum.models >= 15 && datum.price_levels >= 5"
    }
  ],
  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "size": 14,
    "color": "#4e79a7",
    "opacity": 0.65,
    "median": {
      "color": "#1b2430",
      "thickness": 2
    },
    "rule": {
      "color": "#5b6776"
    },
    "ticks": {
      "color": "#5b6776"
    },
    "outliers": {
      "size": 18,
      "color": "#4e79a7",
      "opacity": 0.5
    }
  },
  "encoding": {
    "y": {
      "field": "Brand",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Price",
        "op": "median",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 12,
        "grid": false
      }
    },
    "x": {
      "field": "Price",
      "type": "quantitative",
      "title": "Price (US$, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          10,
          10000
        ]
      },
      "axis": {
        "values": [
          10,
          30,
          100,
          300,
          1000,
          3000,
          10000
        ],
        "format": "$,.0f",
        "grid": true
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "gridColor": "#e4e9f0",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.88)",
      "padding": 6,
      "cornerRadius": 3
    }
  }
}