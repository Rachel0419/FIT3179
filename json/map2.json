{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 480,
  "projection": {
    "type": "mercator",
    "center": [
      139.74,
      35.675
    ],
    "scale": 80000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
        "format": {
          "type": "topojson",
          "feature": "japan"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2E8D5",
        "stroke": "#BDB29E",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/tokyo_clean.csv"
      },
      "transform": [
        {
          "calculate": "floor(datum.longitude * 50) / 50",
          "as": "clon"
        },
        {
          "calculate": "floor(datum.latitude * 50) / 50",
          "as": "clat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "clon",
            "clat"
          ]
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rnk"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rnk <= 10"
        },
        {
          "calculate": "datum.clon + 0.01",
          "as": "lon"
        },
        {
          "calculate": "datum.clat + 0.01",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#4e79a7",
        "opacity": 0.7,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [
              0,
              720
            ],
            "range": [
              0,
              813
            ]
          },
          "legend": {
            "title": "Photos in area",
            "orient": "bottom-right",
            "values": [
              200,
              400,
              700
            ],
            "symbolFillColor": "#4e79a7",
            "symbolOpacity": 0.7
          }
        },
        "tooltip": [
          {
            "field": "n",
            "type": "quantitative",
            "title": "Photos in this area"
          }
        ]
      }
    },
    {
      "data": {
