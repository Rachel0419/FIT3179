{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 320,
  "data": {
    "url": "data/camera_dataset.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Price)",
      "as": "Price"
    },
    {
      "calculate": "toNumber(datum['Effective pixels'])",
      "as": "MP"
    },
    {
      "calculate": "toNumber(datum['Release date']) + (random() - 0.5) * 0.6",
      "as": "x"
    }
  ],
  "mark": {
    "type": "circle",
    "color": "#4e79a7",
    "opacity": 0.35,
    "stroke": null
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "title": "Release year",
      "scale": {
        "domain": [
          1993.5,
          2007.5
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1994,
          1996,
          1998,
          2000,
          2002,
          2004,
          2006
        ],
        "format": "d",
        "grid": false
      }
    },
    "y": {
      "field": "Price",
      "type": "quantitative",
      "title": "Price (US$, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          10,
          10000
        ]
      },
      "axis": {
        "values": [
          10,
          100,
          1000,
          10000
        ],
        "format": "$,.0f",
        "grid": true
      }
    },
    "size": {
      "field": "MP",
      "type": "quantitative",
      "scale": {
        "range": [
          6,
          110
        ],
        "zero": true
      },
      "legend": {
        "title": "Megapixels",
        "orient": "top",
        "direction": "horizontal",
        "values": [
          2,
          5,
          10,
          20
        ],
        "symbolFillColor": "#4e79a7",
        "symbolOpacity": 0.5,
        "symbolStrokeWidth": 0
      }
    },
    "tooltip": [
      {
        "field": "Model",
        "type": "nominal",
        "title": "Camera"
      },
      {
        "field": "Release date",
        "type": "quantitative",
        "title": "Release year",
        "format": "d"
      },
      {
        "field": "Price",
        "type": "quantitative",
        "title": "Price (US$)",
        "format": ",.0f"
      },
      {
        "field": "MP",
        "type": "quantitative",
        "title": "Megapixels"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Open Sans",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1b2430",
      "labelColor": "#5b6776",
      "gridColor": "#edf0f5",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelColor": "#5b6776"
    }
  }
}