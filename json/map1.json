{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 440,
  "projection": {
    "type": "mercator",
    "center": [
      139.74,
      35.67
    ],
    "scale": 65000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
        "format": {
          "type": "topojson",
          "feature": "japan"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F7F5F0",
        "stroke": "#CFC9BC",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/tokyo.topojson",
        "format": {
          "type": "topojson",
          "feature": "tokyo"
        }
      },
      "transform": [
        {
          "calculate": "replace(replace(datum.properties.ward_en, ' Ku', ' City'), ' Shi', ' City')",
          "as": "ward"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8a94a3",
        "strokeWidth": 0.7,
        "strokeOpacity": 0.75
      },
      "encoding": {
        "tooltip": [
          {
            "field": "ward",
            "type": "nominal",
            "title": "Municipality"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/tokyo_clean.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#2b3a55",
        "opacity": 0.28,
        "size": 9,
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".3f"
          },
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".3f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#E6EEF5"
    },
    "font": "Open Sans",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.9)",
      "padding": 6,
      "cornerRadius": 3,
      "strokeColor": "#d8dde5"
    }
  }
}