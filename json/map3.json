{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 440,
  "projection": {
    "type": "mercator",
    "center": [
      139.745,
      35.67
    ],
    "scale": 146000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
        "format": {
          "type": "topojson",
          "feature": "japan"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F7F5F0",
        "stroke": "#CFC9BC",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dataofjapan/land/master/tokyo.topojson",
        "format": {
          "type": "topojson",
          "feature": "tokyo"
        }
      },
      "transform": [
        {
          "calculate": "replace(replace(datum.properties.ward_en, ' Ku', ' City'), ' Shi', ' City')",
          "as": "ward"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8a94a3",
        "strokeWidth": 0.7,
        "strokeOpacity": 0.75
      },
      "encoding": {
        "tooltip": [
          {
            "field": "ward",
            "type": "nominal",
            "title": "Municipality"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#d9532b",
        "opacity": 0.78,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "photos",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              720
            ],
            "range": [
              0,
              2600
            ]
          },
          "legend": {
            "title": "Photos in the area",
            "orient": "bottom-right",
            "values": [
              300,
              500,
              700
            ],
            "symbolFillColor": "#d9532b",
            "symbolOpacity": 0.78,
            "symbolStrokeColor": "#ffffff"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Area"
          },
          {
            "field": "photos",
            "type": "quantitative",
            "title": "Photos"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of all photos",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#ffffff"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof([1,3,10,9], datum.rank) >= 0"
        },
        {
          "calculate": "sqrt(datum.photos * 1.02) + 6",
          "as": "r"
        },
        {
          "calculate": "datum.lon + 1 * datum.r / 2548",
          "as": "tlon"
        },
        {
          "calculate": "datum.lat - 0 * datum.r / 2548 / 1.23",
          "as": "tlat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2430"
      },
      "encoding": {
        "longitude": {
          "field": "tlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "tlat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof([2,4,7], datum.rank) >= 0"
        },
        {
          "calculate": "sqrt(datum.photos * 1.02) + 6",
          "as": "r"
        },
        {
          "calculate": "datum.lon + -1 * datum.r / 2548",
          "as": "tlon"
        },
        {
          "calculate": "datum.lat - 0 * datum.r / 2548 / 1.23",
          "as": "tlat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2430"
      },
      "encoding": {
        "longitude": {
          "field": "tlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "tlat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof([5,6], datum.rank) >= 0"
        },
        {
          "calculate": "sqrt(datum.photos * 1.02) + 6",
          "as": "r"
        },
        {
          "calculate": "datum.lon + 0 * datum.r / 2548",
          "as": "tlon"
        },
        {
          "calculate": "datum.lat - -1 * datum.r / 2548 / 1.23",
          "as": "tlat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2430"
      },
      "encoding": {
        "longitude": {
          "field": "tlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "tlat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "lon": "number",
            "lat": "number",
            "photos": "number",
            "share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof([8], datum.rank) >= 0"
        },
        {
          "calculate": "sqrt(datum.photos * 1.02) + 6",
          "as": "r"
        },
        {
          "calculate": "datum.lon + 0 * datum.r / 2548",
          "as": "tlon"
        },
        {
          "calculate": "datum.lat - 1 * datum.r / 2548 / 1.23",
          "as": "tlat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1b2430"
      },
      "encoding": {
        "longitude": {
          "field": "tlon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "tlat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#E6EEF5"
    },
    "font": "Open Sans",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "fillColor": "rgba(255,255,255,0.9)",
      "padding": 6,
      "cornerRadius": 3,
      "strokeColor": "#d8dde5"
    }
  }
}