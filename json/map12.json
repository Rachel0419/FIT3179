{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": 520,
 "height": 480,
 "projection": {
  "type": "mercator",
  "center": [
   139.74,
   35.675
  ],
  "scale": 80000
 },
 "params": [
  {
   "name": "visitor",
   "value": "95795770@N00",
   "bind": {
    "input": "select",
    "options": [
     "95795770@N00",
     "71453924@N00",
     "24256658@N06",
     "8819274@N04",
     "27889738@N07",
     "38121641@N03",
     "26414679@N05",
     "80072069@N00"
    ],
    "labels": [
     "Visitor A · 419 photos",
     "Visitor B · 419 photos",
     "Visitor C · 291 photos",
     "Visitor D · 204 photos",
     "Visitor E · 144 photos",
     "Visitor F · 120 photos",
     "Visitor G · 78 photos",
     "Visitor H · 78 photos"
    ],
    "name": "Choose a visitor: "
   }
  },
  {
   "name": "minTrips",
   "value": 2,
   "bind": {
    "input": "range",
    "min": 1,
    "max": 6,
    "step": 1,
    "name": "Show routes used at least (times): "
   }
  }
 ],
 "layer": [
  {
   "data": {
    "url": "https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson",
    "format": {
     "type": "topojson",
     "feature": "japan"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#E8ECF1",
    "stroke": "#C3CBD6",
    "strokeWidth": 0.5
   }
  },
  {
   "data": {
    "url": "data/tokyo_clean.csv"
   },
   "mark": {
    "type": "circle",
    "color": "#6b7280",
    "opacity": 0.12,
    "size": 4
   },
   "encoding": {
    "longitude": {
     "field": "longitude",
     "type": "quantitative"
    },
    "latitude": {
     "field": "latitude",
     "type": "quantitative"
    }
   }
  },
  {
   "data": {
    "url": "data/tokyo_clean.csv"
   },
   "transform": [
    {
     "filter": "datum.user_id == visitor"
    },
    {
     "calculate": "toNumber(split(datum['photo/video_page_url'], '/')[5])",
     "as": "pid"
    },
    {
     "calculate": "floor(datum.longitude*50)/50+0.01",
     "as": "clon"
    },
    {
     "calculate": "floor(datum.latitude*50)/50+0.01",
     "as": "clat"
    },
    {
     "window": [
      {
       "op": "row_number",
       "as": "i"
      }
     ],
     "sort": [
      {
       "field": "pid",
       "order": "ascending"
      }
     ]
    },
    {
     "window": [
      {
       "op": "row_number",
       "as": "j"
      }
     ],
     "sort": [
      {
       "field": "pid",
       "order": "descending"
      }
     ]
    },
    {
     "window": [
      {
       "op": "lag",
       "field": "clon",
       "as": "plon"
      },
      {
       "op": "lag",
       "field": "clat",
       "as": "plat"
      }
     ],
     "sort": [
      {
       "field": "pid",
       "order": "ascending"
      }
     ]
    },
    {
     "filter": "datum.plon != null && (datum.clon != datum.plon || datum.clat != datum.plat)"
    },
    {
     "calculate": "(datum.clon < datum.plon || (datum.clon == datum.plon && datum.clat < datum.plat))",
     "as": "fwd"
    },
    {
     "calculate": "datum.fwd ? datum.clon : datum.plon",
     "as": "alon"
    },
    {
     "calculate": "datum.fwd ? datum.clat : datum.plat",
     "as": "alat"
    },
    {
     "calculate": "datum.fwd ? datum.plon : datum.clon",
     "as": "blon"
    },
    {
     "calculate": "datum.fwd ? datum.plat : datum.clat",
     "as": "blat"
    },
    {
     "aggregate": [
      {
       "op": "count",
       "as": "trips"
      }
     ],
     "groupby": [
      "alon",
      "alat",
      "blon",
      "blat"
     ]
    },
    {
     "filter": "datum.trips >= minTrips"
    }
   ],
   "mark": {
    "type": "rule",
    "color": "#4e79a7",
    "opacity": 0.55,
    "strokeCap": "round"
   },
   "encoding": {
    "longitude": {
     "field": "alon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "alat",
     "type": "quantitative"
    },
    "longitude2": {
     "field": "blon"
    },
    "latitude2": {
     "field": "blat"
    },
    "strokeWidth": {
     "field": "trips",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "range": [
       1,
       7
      ]
     },
     "legend": {
      "title": "Times route used",
      "orient": "bottom-right",
      "values": [
       2,
       5,
       10
      ]
     }
    },
    "tooltip": [
     {
      "field": "trips",
      "type": "quantitative",
      "title": "Times this route was used"
     }
    ]
   }
  },
